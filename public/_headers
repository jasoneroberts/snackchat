# Cache rules for files served straight from the build (Workers static assets).
# Files in /assets/ have a content hash in their name, so a name always means
# the same bytes: phones may keep them for a year without checking back.
# Everything else keeps Cloudflare's default (check for changes every time),
# so index.html and sw.js are always fresh after a deploy.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
