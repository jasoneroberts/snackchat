// Cloudflare configuration for the Crunchd Worker.
// Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "snackchat",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],

  // The app's real address. Cloudflare creates the DNS record and the https
  // certificate for each custom domain on deploy, so the domain must already
  // be in this Cloudflare account. www.getcrunchd.com is caught too, and the
  // Worker redirects it (and the old workers.dev link) to getcrunchd.com.
  "routes": [
    { "pattern": "getcrunchd.com", "custom_domain": true },
    { "pattern": "www.getcrunchd.com", "custom_domain": true }
  ],
  // Keep the old snackchat.jasoneroberts.workers.dev link answering (adding
  // routes would otherwise switch it off) so it can redirect people, and keep
  // preview links for pull requests.
  "workers_dev": true,
  "preview_urls": true,

  // The React app is built into static files. Page requests go to the Worker
  // first so it can redirect the old address (worker/lib/canonicalHost.ts);
  // the Worker then hands them back to the build via env.ASSETS, falling back
  // to index.html so the app's own routes (/login, /signup) work on refresh.
  // Vite's hashed files in /assets/ skip the Worker, since they never need
  // a redirect and this keeps the Worker request count down.
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/*", "!/assets/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "snackchat-db",
      "database_id": "7bc8b9b1-77af-43c5-98fa-f538f54293c6",
      "migrations_dir": "migrations"
    }
  ],

  "kv_namespaces": [
    { "binding": "CACHE", "id": "d99b2213559f4f9988d41fef70b59de1" }
  ],

  // Check-in photos. The Worker reads and writes them through env.PHOTOS.
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "snackchat-photos" }],

  // Cloudflare Images: shrinks check-in photos for thumbnails (worker/lib/thumbs.ts).
  // Free for the first 5,000 different photo sizes a month; if it's ever
  // unavailable the full-size photo is served instead.
  "images": { "binding": "IMAGES" },

  // Simple per-key rate limits, counted per Cloudflare location.
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    // Changes (check-ins, likes, reports...) per person per minute (worker/lib/limits.ts).
    { "name": "WRITE_LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
  ],

  "vars": {
    "APP_NAME": "Crunchd",
    // The one address people should use; others redirect here.
    "CANONICAL_HOST": "getcrunchd.com",
    // "log" prints verification links to the Worker logs (wrangler tail);
    // "resend" sends real email and needs RESEND_API_KEY and EMAIL_FROM.
    "EMAIL_MODE": "log",
    "EMAIL_FROM": "Crunchd <hello@example.com>",
    // Sign in with a name and a PIN instead of email and password. Anyone
    // can join; new accounts pass the Turnstile bot check first, so the real
    // Turnstile keys must be set (TURNSTILE_SECRET_KEY on the Worker and
    // VITE_TURNSTILE_SITE_KEY in the build). "off" switches to email sign-up.
    // (DEV_LOGIN_AS="<name>" signs everyone in as that user, for local work only.)
    "QUICK_SIGNIN": "on"
  },

  // Timed jobs (see scheduled() in worker/index.ts): an hourly check that
  // emails the admin if errors spike, and a nightly backup at 03:00 UTC.
  "triggers": { "crons": ["0 * * * *", "0 3 * * *"] },

  "observability": { "enabled": true }
}
